# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Built-in API key (see lib/core/embedded_key.dart and secrets.example.json)
/lib/core/secrets.dart
/secrets.json

# Visual renders (local only)
docs/screenshots/
*.render.png

# Release packages (tool/package_windows.ps1, CI)
/dist/

# Local overrides and environment files
pubspec_overrides.yaml
.env
.env.*
.fvm/

# Agent and editor caches
.claude/settings.local.json
*.bak
*.tmp
*.orig

# OS clutter (Windows, macOS)
Thumbs.db
desktop.ini
.Spotlight-V100
.Trashes

# Python helpers (tool/make_app_icon.py, test/fixtures/*/generate*.py)
__pycache__/
.venv/
venv/

# Flutter crash screenshots and failed golden images
flutter_*.png
**/failures/

# Project context notes (local only)
/PROJECT_CONTEXT.md
