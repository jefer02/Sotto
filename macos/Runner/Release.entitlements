<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  No App Sandbox: Sotto is a personal-use app, not distributed through the
  App Store, and the sandbox blocks what questionnaire filling and agent mode
  need - reading other apps' accessibility trees (AX API) and posting mouse
  and keyboard events (CGEvent). Access is still gated by macOS privacy
  permissions: Microphone, Screen Recording and Accessibility (see README).
-->
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
